    <string name="notif_inactivity_title">Sesión cerrada por inactividad</string>
    <string name="notif_inactivity_body">Por seguridad cerramos la sesión. Volvé a ingresar para seguir trabajando.</string>
    <string name="notif_entitlement_title">Cambios sin subir</string>
    <string name="notif_entitlement_body">El plan o la suscripción no permite enviar cambios a la nube por ahora. Los datos siguen en el teléfono.</string>
