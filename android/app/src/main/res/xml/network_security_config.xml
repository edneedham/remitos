<?xml version="1.0" encoding="utf-8"?>
<!-- Release / non-debug: HTTPS to production; cleartext not used for the API. -->
<!-- Debug builds use src/debug/res/xml/network_security_config.xml (cleartext allowed for local HTTP). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
