{
  "$schema": "./schema.json",
  "_note": "Single source of truth for visual design tokens shared by the En Punto Next.js website and the Android Compose app. After editing, run `pnpm --filter enpunto-website gen:tokens` AND `./gradlew :app:genTokens` (or `pnpm tokens:gen-all` from the repo root) to regenerate the platform files. Do NOT hand-edit the generated outputs; CI verifies they are in sync with this file.",
  "color": {
    "brand": {
      "primary": "#006cff",
      "primaryHover": "#0058d6",
      "primaryPressed": "#0048b3",
      "primarySubtle": "#dbeafe",
      "primarySurface": "#f0f5ff",
      "red": "#D0001E",
      "redHover": "#A8001B",
      "redSubtle": "#fbe4e8"
    },
    "neutral": {
      "n50": "#fafafa",
      "n100": "#f5f5f5",
      "n200": "#e8e8e8",
      "n300": "#bdbdbd",
      "n400": "#9e9e9e",
      "n500": "#757575",
      "n600": "#616161",
      "n700": "#424242",
      "n800": "#2d2d2d",
      "n900": "#1a1a1a"
    },
    "semantic": {
      "success": "#1f9d55",
      "successSubtle": "#d1fae5",
      "successOn": "#065f46",
      "warning": "#b45309",
      "warningSubtle": "#fef3c7",
      "warningOn": "#7c2d12",
      "error": "#D0001E",
      "errorSubtle": "#fee2e2",
      "errorOn": "#7f1d1d",
      "info": "#006cff",
      "infoSubtle": "#dbeafe",
      "infoOn": "#1e3a8a"
    },
    "surface": {
      "background": "#ffffff",
      "muted": "#f9fafb",
      "border": "#e5e7eb",
      "text": "#111827",
      "textMuted": "#4b5563"
    },
    "button": {
      "disabledBackground": "#e1e2e4",
      "disabledContent": "#919194"
    }
  },
  "radius": {
    "xs": 6,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "pill": 9999
  },
  "spacing": {
    "item": 8,
    "section": 16,
    "screen": 20,
    "large": 24,
    "xlarge": 32,
    "huge": 48
  },
  "type": {
    "family": "Inter",
    "scale": {
      "displayLarge": { "size": 32, "lineHeight": 40, "weight": 700, "letterSpacing": -0.5 },
      "displayMedium": { "size": 28, "lineHeight": 36, "weight": 700, "letterSpacing": -0.25 },
      "displaySmall": { "size": 24, "lineHeight": 32, "weight": 600, "letterSpacing": 0 },
      "headlineLarge": { "size": 22, "lineHeight": 28, "weight": 700, "letterSpacing": 0 },
      "headlineMedium": { "size": 20, "lineHeight": 26, "weight": 600, "letterSpacing": 0 },
      "headlineSmall": { "size": 18, "lineHeight": 24, "weight": 600, "letterSpacing": 0 },
      "titleLarge": { "size": 18, "lineHeight": 24, "weight": 600, "letterSpacing": 0 },
      "titleMedium": { "size": 16, "lineHeight": 22, "weight": 500, "letterSpacing": 0.1 },
      "titleSmall": { "size": 14, "lineHeight": 20, "weight": 500, "letterSpacing": 0.1 },
      "bodyLarge": { "size": 16, "lineHeight": 24, "weight": 400, "letterSpacing": 0.15 },
      "bodyMedium": { "size": 14, "lineHeight": 20, "weight": 400, "letterSpacing": 0.25 },
      "bodySmall": { "size": 12, "lineHeight": 16, "weight": 400, "letterSpacing": 0.4 },
      "labelLarge": { "size": 14, "lineHeight": 20, "weight": 500, "letterSpacing": 0.1 },
      "labelMedium": { "size": 12, "lineHeight": 16, "weight": 500, "letterSpacing": 0.5 },
      "labelSmall": { "size": 11, "lineHeight": 16, "weight": 500, "letterSpacing": 0.5 }
    }
  }
}
